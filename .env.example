# Hermod needs no secrets to build or test. CI uses none.
# Copy to .env only for the optional runs below. .env is git-ignored; never commit it.

# Only for the opt-in live evals (npm run eval:live). They call the real Anthropic API and cost money
# (capped at USD 0.50 per run, see evals/README.md). They run only when both are set; leave them empty to skip.
HERMOD_LIVE=
ANTHROPIC_API_KEY=

# Only for the Postgres adapter tests. A throwaway database you can drop (for example a local Postgres 16).
# The tests create and drop their own schema in it. Never point it at a real project.
HERMOD_TEST_DATABASE_URL=

# Set to 1 to make the Postgres tests fail instead of skip when HERMOD_TEST_DATABASE_URL is missing (CI sets it).
HERMOD_REQUIRE_PG_TESTS=
